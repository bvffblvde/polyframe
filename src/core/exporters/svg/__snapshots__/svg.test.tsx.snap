// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`svg export > snapshots the styled login screen 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="800" viewBox="0 0 1280 800">
<title>Login</title>
<defs><clipPath id="artboard"><rect width="1280" height="800"/></clipPath></defs>
<g id="Login" clip-path="url(#artboard)">
<rect x="0" y="0" width="1280" height="800" fill="#ffffff"/>
<g id="Card" transform="translate(440 160)"><rect x="0" y="0" width="400" height="460" rx="10" fill="#ffffff" stroke="#e5e5e5" stroke-width="1"/></g>
<g id="Heading" transform="translate(480 200)"><text x="160" y="22.8" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="24" fill="#0a0a0a" font-weight="600" text-anchor="middle">Welcome back</text></g>
<g id="Text" transform="translate(480 244)"><text x="160" y="13.17" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="12.25" fill="#737373" text-anchor="middle">Sign in to your account</text></g>
<g id="Text-input" transform="translate(480 292)"><text x="0" y="13.9" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="14" fill="#0a0a0a" font-weight="500">Email</text><rect x="0" y="26" width="320" height="36" rx="6" fill="#ffffff" stroke="#e5e5e5" stroke-width="1"/><text x="12" y="48.9" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="14" fill="#737373">you@example.com</text></g>
<g id="Text-input-2" transform="translate(480 372)"><text x="0" y="13.9" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="14" fill="#0a0a0a" font-weight="500">Password</text><rect x="0" y="26" width="320" height="36" rx="6" fill="#ffffff" stroke="#e5e5e5" stroke-width="1"/><text x="12" y="48.9" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="14" fill="#737373">••••••••</text></g>
<g id="Checkbox" transform="translate(480 452)"><g><rect x="0" y="4" width="16" height="16" rx="3" fill="#171717" stroke="#171717" stroke-width="1"/><path d="M4 12 l3 3 l5 -6" fill="none" stroke="#fafafa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><text x="24" y="16.9" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="14" fill="#0a0a0a">Remember me</text></g></g>
<g id="Link" transform="translate(664 452)"><text x="0" y="16.9" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="14" fill="#171717">Forgot password?</text></g>
<g id="Button" transform="translate(480 500)"><g><rect x="0" y="0" width="320" height="40" rx="6" fill="#171717" stroke="#171717" stroke-width="1"/><text x="160" y="24.9" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="14" fill="#fafafa" font-weight="500" text-anchor="middle">Sign in</text></g></g>
<g id="Text-2" transform="translate(480 564)"><text x="160" y="13.17" font-family="Geist, ui-sans-serif, system-ui, sans-serif" font-size="12.25" fill="#737373" text-anchor="middle">No account yet? Sign up</text></g>
</g>
</svg>"
`;
